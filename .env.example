# Variables de entorno para infoSalamanca

# Configuración de la base de datos
# Para Docker Compose: el compose construye MONGODB_URI con estas dos variables.
# Usa una contraseña larga solo con letras y números (sin @ : / ? #, que rompen la URI).
# Genera una con: openssl rand -hex 24
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambia_esto

# Para desarrollo local (descomenta si usas MongoDB local)
# MONGODB_URI=mongodb://localhost:27017/infosalamanca

# Configuración del backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
NODE_ENV=production

# Redis
REDIS_URL=redis://redis:6379

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api

USER_AGENT=your-app-name/0.1

# Administración: clave para las rutas que escriben datos (carteles, contacto) y para /admin/carteles.html
# Genera una con: openssl rand -hex 32
ADMIN_TOKEN=

# Buscador de carteles de fiestas (opcional): clave de la Brave Search API
BRAVE_API_KEY=
