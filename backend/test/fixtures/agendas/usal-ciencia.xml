      &lt;div class="field field--name-field-categorias field--type-entity-reference field--label-hidden field__items"&gt;
              &lt;div class="field__item"&gt;&lt;a href="https://comunicacion.usal.es/ciencia" hreflang="es"&gt;Ciencia&lt;/a&gt;&lt;/div&gt;
          &lt;/div&gt;
  
