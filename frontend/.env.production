# Variables de entorno para producción
VITE_ENV=production

# Las URLs del backend se gestionan automáticamente
# En producción usan rutas relativas que nginx maneja
# No es necesario definir VITE_BACKEND_HOST

# DEPRECATED: Langflow ha sido reemplazado por LangChain Service integrado en el backend
# VITE_LANGFLOW_API_KEY ya no es necesaria

# Chatbot SaLLMantino (la rana). Desactivado hasta tener el asesor nuevo.
VITE_CHAT_ENABLED=false
