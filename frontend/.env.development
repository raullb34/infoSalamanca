# Variables de entorno para desarrollo
VITE_ENV=development

# URLs del backend en desarrollo
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=4000

# DEPRECATED: Langflow ha sido reemplazado por LangChain Service
# Las llamadas al chat ahora van a través del backend (/api/chat)
# VITE_LANGFLOW_HOST y VITE_LANGFLOW_PORT ya no son necesarias
# VITE_LANGFLOW_API_KEY ya no es necesaria

# Asistente SaLLMantino (la rana, /api/chat). false para ocultarlo.
VITE_CHAT_ENABLED=true
